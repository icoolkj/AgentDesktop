{
  "name": "@agent-desktop/desktop",
  "productName": "Agent Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Desktop — Electron desktop client",
  "author": {
    "name": "daipeng",
    "email": "icoolkj@163.com",
    "url": "https://agentdesktop.cn"
  },
  "homepage": "https://agentdesktop.cn",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.yml",
    "package:win": "electron-builder --win --config electron-builder.yml",
    "package:mac": "electron-builder --mac --config electron-builder.yml",
    "package:linux": "electron-builder --linux --config electron-builder.yml",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "postinstall": "electron-rebuild -o better-sqlite3 -f && node scripts/ensure-node-pty-prebuild.cjs"
  },
  "dependencies": {
    "@agent-desktop/shared-types": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.10.0",
    "mermaid": "^11.4.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "1.2.0-beta.13",
    "pinia": "^2.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.60.0",
    "@types/ws": "^8.18.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7",
    "vue-tsc": "^2.2.0",
    "ws": "^8.18.3"
  }
}

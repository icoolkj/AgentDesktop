# =============================================================================
# Agent Desktop — .gitignore
# 栈：pnpm monorepo + Electron (desktop) + Spring Boot (server) + shared types
# =============================================================================

# --- Dependencies ---
node_modules/

# --- Build outputs ---
dist/
out/
target/
release/
dist-electron/
*.tsbuildinfo

# --- Logs & debug ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test & coverage ---
coverage/
.nyc_output/
.vitest/
test-results/
playwright-report/
server/target/surefire-reports/

# --- Environment & secrets（勿提交） ---
.env
.env.*
!.env.example
scripts/env.local.ps1

# --- 私钥 / 证书 / 本地数据文件（防止误提交） ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.enc
*.db
*.sqlite
*.sqlite3

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / Editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Java / Maven（补充 target 未覆盖项） ---
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.classpath
.project
.settings/
.factorypath

# --- Electron / Vite cache ---
.eslintcache
.cache/
*.local

# --- Optional local overrides ---
*.swp
*.swo
*~

# --- 本地工作记忆（内部笔记，不随开源仓库发布） ---
.workbuddy/memory/

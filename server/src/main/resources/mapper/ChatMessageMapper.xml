<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentdesktop.server.mapper.ChatMessageMapper">

    <resultMap id="ChatMessageMap" type="com.agentdesktop.server.domain.ChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="toolsJson" column="tools_json"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_message (session_id, role, content, tools_json, created_at)
        VALUES (#{sessionId}, #{role}, #{content}, #{toolsJson}, NOW())
    </insert>

    <select id="listBySessionId" resultMap="ChatMessageMap">
        SELECT id, session_id, role, content, tools_json, created_at
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY created_at ASC
    </select>
</mapper>

# Agent Desktop — 本地开发环境变量示例
#
# 用法：复制为 .env（已在 .gitignore 中），按需修改后不要提交。
# 说明：docker compose 会自动读取根目录 .env 做变量替换；
#       Spring Boot 后端需由启动环境 / IDEA Run Configuration 注入同名变量，
#       Windows 下可参考 scripts/env.local.example.ps1。
#       详见 docs/dev-guide.md

# --- MySQL（docker-compose.yml 使用） ---
MYSQL_ROOT_PASSWORD=change-me-before-sharing
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent_desktop
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- 后端 / Electron ---
AGENT_SERVER_PORT=5566
AGENT_WS_URL=ws://127.0.0.1:5566/ws

# --- LLM（也可在应用「设置 → 模型」中配置，二选一） ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Java（仅 Electron 自行 spawn jar 时需要） ---
# JAVA_HOME=
# AGENT_JAVA_HOME=
